---
import { SITE_CONFIG } from '../../config/site.config';
---

<section class="relative min-h-screen flex items-center overflow-hidden">
  
  <!-- Background Effects -->
  <div class="absolute inset-0 opacity-20">
    <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full blur-3xl" style="background-color: rgba(59, 130, 246, 0.3);"></div>
    <div class="absolute bottom-1/4 right-1/4 w-96 h-96 rounded-full blur-3xl" style="background-color: rgba(6, 182, 212, 0.3);"></div>
  </div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 w-full">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      
      <!-- Left Column -->
      <div style="display: flex; flex-direction: column; gap: 2rem;">
        
        <!-- Status Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full text-sm font-mono" style="background-color: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); color: #10b981; width: fit-content;">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75" style="background-color: #10b981;"></span>
            <span class="relative inline-flex rounded-full h-2 w-2" style="background-color: #10b981;"></span>
          </span>
          Available for Opportunities
        </div>
        
        <!-- Name -->
        <h1 class="text-6xl lg:text-7xl font-bold" style="line-height: 1.1;">
          <span class="block" style="color: #e2e8f0;">Abdul Muqeet</span>
          <span class="gradient-text block">Tabraiz</span>
        </h1>
        
        <!-- Titles -->
        <div style="display: flex; flex-direction: column; gap: 0.5rem;">
          <p class="text-lg font-mono" style="color: #94a3b8;">
            <span style="color: #60a5fa;">&gt;</span> Cyber Security Instructor
          </p>
          <p class="text-lg font-mono" style="color: #94a3b8;">
            <span style="color: #22d3ee;">&gt;</span> SOC Analyst & Threat Hunter
          </p>
          <p class="text-lg font-mono" style="color: #94a3b8;">
            <span style="color: #a78bfa;">&gt;</span> Open Source AI Security Developer
          </p>
        </div>
        
        <!-- Description -->
        <p class="text-lg leading-relaxed max-w-lg" style="color: #94a3b8;">
          Building open-source security tools, teaching cyber defense, 
          and hunting threats. Dedicated to making security accessible 
          through automation and AI.
        </p>
        
        <!-- Buttons -->
        <div class="flex flex-wrap gap-4">
          <a href="/projects" class="inline-flex items-center gap-2 px-6 py-3 font-medium rounded-lg transition-all duration-300 text-white" style="background-color: #3b82f6;">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
            </svg>
            View Projects
          </a>
          <a href="/resume" class="inline-flex items-center gap-2 px-6 py-3 font-medium rounded-lg transition-all duration-300" style="border: 1px solid rgba(59, 130, 246, 0.5); color: #60a5fa;">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            Download Resume
          </a>
        </div>
        
        <!-- Social Links -->
        <div class="flex items-center gap-6 text-sm" style="color: #64748b;">
          <a href={SITE_CONFIG.github.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-text-secondary transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
            GitHub
          </a>
          <a href={SITE_CONFIG.linkedin.url} target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-text-secondary transition-colors">
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            LinkedIn
          </a>
        </div>
      </div>
      
      <!-- Right Column - Terminal -->
      <div class="hidden lg:block">
        <div class="glass-panel p-1 rounded-2xl">
          <!-- Terminal Header -->
          <div class="flex items-center gap-2 px-4 py-3 border-b border-surface-border">
            <div class="w-3 h-3 rounded-full" style="background-color: #ef4444;"></div>
            <div class="w-3 h-3 rounded-full" style="background-color: #f59e0b;"></div>
            <div class="w-3 h-3 rounded-full" style="background-color: #10b981;"></div>
            <span class="ml-3 text-xs font-mono" style="color: #64748b;">security-dashboard.sh</span>
          </div>
          
          <!-- Terminal Content -->
          <div class="p-6 font-mono text-sm" style="display: flex; flex-direction: column; gap: 0.75rem;">
            <p style="color: #22d3ee;">
              <span style="color: #64748b;">[</span><span style="color: #10b981;">+</span><span style="color: #64748b;">]</span> Initializing Security Environment...
            </p>
            <p style="color: #64748b;">
              <span style="color: #64748b;">[</span><span style="color: #60a5fa;">*</span><span style="color: #64748b;">]</span> Connecting to GitHub <span style="color: #60a5fa;">@JuttSahib1999</span>
            </p>
            <p style="color: #64748b;">
              <span style="color: #64748b;">[</span><span style="color: #a78bfa;">~</span><span style="color: #64748b;">]</span> Loading repositories...
            </p>
            <p style="color: #64748b;">
              <span style="color: #64748b;">[</span><span style="color: #22d3ee;">+</span><span style="color: #64748b;">]</span> Scanning security modules...
            </p>
            <p style="color: #64748b;">
              <span style="color: #64748b;">[</span><span style="color: #60a5fa;">*</span><span style="color: #64748b;">]</span> Loading AI security tools...
            </p>
            
            <div class="pt-4 border-t border-surface-border">
              <p style="color: #10b981; font-weight: bold;">
                <span style="color: #64748b;">[</span><span style="color: #10b981;">✓</span><span style="color: #64748b;">]</span> 
                STATUS: SYSTEM READY
              </p>
              <p class="mt-2" style="color: #64748b;">
                <span class="animate-pulse">█</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>