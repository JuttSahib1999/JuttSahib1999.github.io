---
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('blog');

// Filter out drafts and sort by date
const posts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<MainLayout
  title="Blog | Abdul Muqeet Tabraiz"
  description="Cyber security articles, tutorials, and insights by Abdul Muqeet Tabraiz"
>
  <Navbar />
  
  <main class="pt-24 pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-4">
          Security Blog
        </h1>
        <p class="text-text-secondary text-lg">
          Articles on SOC operations, threat hunting, AI security, and career development.
        </p>
      </div>
      
      <!-- Blog Stats -->
      <div class="glass-panel p-4 mb-8 text-center">
        <p class="text-text-secondary">
          <span class="text-cyber-400 font-semibold">{posts.length}</span> article{posts.length !== 1 ? 's' : ''} published
        </p>
      </div>
      
      <!-- DEBUG: Show slugs -->
      <div class="glass-panel p-4 mb-4">
      <p class="text-text-muted text-sm">Debug - Found posts:</p>
      {posts.map(p => (
          <p class="text-text-muted text-xs">Slug: "{p.slug}", ID: "{p.id}"</p>
      ))}
      </div>

      <!-- Blog Posts List -->
      {posts.length > 0 ? (
        <div class="space-y-6">
          {posts.map((post) => (
            <article class="glass-panel p-6 transition-all duration-300 hover:border-cyber-500/30">
              <div class="flex items-center gap-3 text-text-muted text-sm mb-3">
                <span>📅 {post.data.date.toLocaleDateString('en-US', { 
                  year: 'numeric', 
                  month: 'long', 
                  day: 'numeric' 
                })}</span>
                <span>•</span>
                <span>{Math.ceil((post.body?.length || 1000) / 1500)} min read</span>
              </div>
              
              <h2 class="text-xl font-semibold text-text-primary mb-2">
                <a href={`/blog/${post.id}`} class="hover:text-cyber-400 transition-colors">
                  {post.data.title}
                </a>
              </h2>
              
              <p class="text-text-secondary mb-4">
                {post.data.description}
              </p>
              
              <div class="flex flex-wrap gap-2">
                <span class="px-3 py-1 text-xs rounded-full bg-cyber-500/10 text-cyber-400">
                  {post.data.category}
                </span>
                {post.data.tags.map((tag: string) => (
                  <span class="px-3 py-1 text-xs rounded-full bg-surface text-text-muted border border-surface-border">
                    {tag}
                  </span>
                ))}
              </div>
              
              <a href={`/blog/${post.id}`} class="inline-flex items-center gap-1 mt-4 text-soc-400 text-sm hover:text-soc-300 transition-colors">
                Read Article
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="glass-panel p-12 text-center">
          <div class="text-6xl mb-4">✍️</div>
          <h2 class="text-2xl font-bold text-text-primary mb-2">No Articles Yet</h2>
          <p class="text-text-secondary">Check back soon for security articles and tutorials.</p>
        </div>
      )}
      
    </div>
  </main>
  
  <Footer />
</MainLayout>