---
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
---

<MainLayout
  title="Blog | Abdul Muqeet Tabraiz"
  description="Cyber security articles, tutorials, and insights by Abdul Muqeet Tabraiz"
>
  <Navbar />
  
  <main class="pt-24 pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-4">
          Blog
        </h1>
        <p class="text-text-secondary text-lg">
          Articles, tutorials, and insights on cyber security, SOC operations, and AI security tools.
        </p>
      </div>
      
      <!-- Blog Posts List -->
      <div class="space-y-6">
        
        <!-- Sample Blog Post Card -->
        <article class="glass-panel p-6 transition-all duration-300 hover:border-cyber-500/30">
          <div class="flex items-center gap-3 text-text-muted text-sm mb-3">
            <span>📅 Coming Soon</span>
            <span>•</span>
            <span>5 min read</span>
          </div>
          <h2 class="text-xl font-semibold text-text-primary mb-2">
            Getting Started with SOC Analysis
          </h2>
          <p class="text-text-secondary mb-4">
            A beginner-friendly guide to understanding Security Operations Center workflows, tools, and methodologies.
          </p>
          <div class="flex flex-wrap gap-2">
            <span class="px-3 py-1 text-xs rounded-full bg-cyber-500/10 text-cyber-400">SOC</span>
            <span class="px-3 py-1 text-xs rounded-full bg-soc-500/10 text-soc-400">Beginner</span>
            <span class="px-3 py-1 text-xs rounded-full bg-surface text-text-muted border border-surface-border">Tutorial</span>
          </div>
        </article>
        
        <!-- Coming Soon Placeholder -->
        <div class="glass-panel p-12 text-center">
          <div class="text-6xl mb-4">✍️</div>
          <h2 class="text-2xl font-bold text-text-primary mb-2">
            More Articles Coming Soon
          </h2>
          <p class="text-text-secondary max-w-md mx-auto">
            I'm currently writing detailed articles on cyber security topics. 
            Check back soon or follow me on GitHub for updates.
          </p>
          <div class="flex justify-center gap-4 mt-6">
            <a href="/projects" class="inline-flex items-center gap-2 px-4 py-2 bg-cyber-500 text-white rounded-lg text-sm font-medium hover:bg-cyber-600 transition-colors">
              View Projects
            </a>
            <a href="/contact" class="inline-flex items-center gap-2 px-4 py-2 border border-surface-border text-text-secondary rounded-lg text-sm font-medium hover:text-text-primary transition-colors">
              Contact Me
            </a>
          </div>
        </div>
        
      </div>
      
    </div>
  </main>
  
  <Footer />
</MainLayout>