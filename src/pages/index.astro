---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import HeroSection from '../components/sections/HeroSection.astro';
import Footer from '../components/layout/Footer.astro';
---

<MainLayout
  title="Abdul Muqeet Tabraiz | Cyber Security Portfolio"
  description="Professional Cyber Security Portfolio"
>
  <Navbar />
  <HeroSection />
  
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl font-bold gradient-text mb-4">Welcome</h2>
      <p class="text-text-secondary text-lg">
        Cyber Security Instructor | SOC Analyst | AI Security Developer
      </p>
      <a href="/projects" class="inline-block mt-6 px-6 py-3 bg-cyber-500 text-white rounded-lg font-medium hover:bg-cyber-600 transition-colors">
        View Projects
      </a>
    </div>
  </section>
  
  <Footer />
</MainLayout>