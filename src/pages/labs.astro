---
// src/pages/labs.astro
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';

// --- Complete Lab Data with All Your Information ---
const labs = [
  {
    id: 'soc-foundations',
    title: 'SOC Foundations & Threat Detection',
    subtitle: 'SIEM, IDS, Network Security Monitoring',
    weekRange: 'Weeks 1-4',
    status: 'Completed',
    icon: '🛡️',
    description: 'Deployed and configured a complete Security Operations Center (SOC) from the ground up. Built a layered monitoring architecture using Wazuh SIEM, Suricata IDS, and pfSense firewall.',
    tasks: [
      'Deployed Wazuh Manager and Agents on Ubuntu/Kali/Windows for host-based intrusion detection',
      'Configured File Integrity Monitoring (FIM) on critical directories (/etc, C:\\Windows)',
      'Installed and configured Suricata IDS with custom rules for Nmap scans, HTTP attacks, and ICMP floods',
      'Integrated Suricata alerts into Wazuh for unified dashboard visibility',
      'Deployed pfSense firewall as network perimeter with syslog forwarding to Wazuh',
      'Wrote custom Wazuh rules for SSH brute force, USB insertion, and user account creation',
      'Implemented GeoIP blocking using ipset and iptables for China, Russia, and North Korea'
    ],
    tools: ['Wazuh SIEM', 'Suricata IDS', 'pfSense Firewall', 'Ubuntu/Kali Linux', 'Wireshark', 'Elastic Stack'],
    findings: [
      'Successfully correlated network (Suricata) and host-based (Wazuh) alerts for 360-degree visibility',
      'Custom SSH brute-force rule (100200) triggered automatic IP blocking via active response',
      'Created 3 custom Suricata rules validated against live PCAP traffic'
    ],
    artifacts: [
      { name: 'Wazuh Dashboard Overview (PDF)', path: '/artifacts/soc-foundations/wazuh-module-overview-general.pdf', size: '1.5 MB' },
      { name: 'Wazuh MITRE Dashboard (PDF)', path: '/artifacts/soc-foundations/wazuh-module-overview-mitre.pdf', size: '1.2 MB' },
      { name: 'Suricata Custom Rules (TXT)', path: '/artifacts/soc-foundations/suricata-rules.txt', size: '2 KB' },
      { name: 'Week 2 Report (PDF)', path: '/artifacts/soc-foundations/Week_2_Report.pdf', size: '4.5 MB' },
      { name: 'Week 3 Report (PDF)', path: '/artifacts/soc-foundations/Week_3_Report.pdf', size: '4.2 MB' },
      { name: 'Week 4 Report (PDF)', path: '/artifacts/soc-foundations/Week_4_Report.pdf', size: '3.8 MB' }
    ]
  },
  {
    id: 'malware-analysis',
    title: 'Malware Analysis & Incident Response',
    subtitle: 'Static & Dynamic Analysis, Detection Engineering',
    weekRange: 'Week 5',
    status: 'Completed',
    icon: '🦠',
    description: 'Conducted a comprehensive investigation of two malware families (Zeus Banking Trojan & njRAT). Performed safe, air-gapped analysis and developed production-ready detection rules.',
    tasks: [
      'Established a secure, air-gapped analysis environment using pfSense WAN isolation',
      'Performed static analysis (file identification, strings, binwalk, exiftool) to extract IOCs',
      'Computed cryptographic hashes (MD5, SHA-256) for malware identification',
      'Executed dynamic analysis in ANY.RUN sandbox to observe real-time behavior',
      'Mapped malware behaviors to MITRE ATT&CK framework',
      'Developed 5 custom Suricata rules for Zeus C2 and payload detection',
      'Authored a NIST SP 800-61 compliant Incident Response Plan'
    ],
    tools: ['ANY.RUN Sandbox', 'Suricata', 'Wazuh', 'strings/binwalk', 'MITRE ATT&CK', 'VirusTotal'],
    findings: [
      'Zeus (ZAccess) identified as banking trojan with 64/72 antivirus detections',
      'njRAT confirmed as Remote Access Trojan using persistence and firewall evasion',
      'Created 5 Suricata rules that successfully detected Zeus C2 traffic'
    ],
    artifacts: [
      { name: 'Malware Analysis Report (PDF)', path: '/artifacts/malware-analysis/Abdul_Muqeet_Tabraiz_Cyberster_Week_5_Report.pdf', size: '5.2 MB' },
      { name: 'Indicators of Compromise (CSV)', path: '/artifacts/malware-analysis/iocs.csv', size: '3 KB' },
      { name: 'Zeus ANY.RUN Analysis (Link)', path: 'https://app.any.run/tasks/0c078148-d9c6-4d7e-8130-b1c0922d643f', size: '🔗' },
      { name: 'njRAT ANY.RUN Analysis (Link)', path: 'https://app.any.run/tasks/ddb309fa-f27b-49d9-a993-73fe289b5e82', size: '🔗' }
    ]
  },
  {
    id: 'insider-threat',
    title: 'Insider Threat Simulation',
    subtitle: 'Attack and Defend with Living-off-the-Land (LOLBins)',
    weekRange: 'Week 6',
    status: 'Completed',
    icon: '🔐',
    description: 'Executed a complete insider threat attack chain from both Red and Blue Team perspectives. Used legitimate Windows tools (LOLBins) for data exfiltration and built custom detection rules.',
    tasks: [
      'Acted as Red Team insider using PowerShell and certutil.exe to stage and encode data',
      'Exfiltrated Base64-encoded data via HTTP POST to a netcat listener',
      'Performed anti-forensics by deleting all evidence (files and registry keys)',
      'Switched to Blue Team to hunt for FIM alerts in Wazuh dashboard',
      'Decoded exfiltrated data using CyberChef to recover stolen credentials',
      'Engineered custom Wazuh rule (ID 100500) to detect Base64 file creation'
    ],
    tools: ['Wazuh FIM', 'PowerShell', 'certutil.exe', 'CyberChef', 'MITRE ATT&CK', 'Netcat'],
    findings: [
      'Wazuh FIM captured all file creation, modification, and deletion events in real-time',
      'Custom rule 100500 deployed to detect encoded staging files (MITRE T1027)',
      'Recovered stolen credentials: CLIENT: Cyberster | ACCT: 4459 | PW: AdminPassword2026!'
    ],
    artifacts: [
      { name: 'Insider Threat Simulation Report (PDF)', path: '/artifacts/insider-threat/Abdul_Muqeet_Tabraiz_Cyberster_Week_6_Report.pdf', size: '4.8 MB' },
      { name: 'Custom Wazuh Rule 100500 (XML)', path: '/artifacts/insider-threat/wazuh-rule-100500.xml', size: '1 KB' },
      { name: 'Decoded Exfiltrated Data (TXT)', path: '/artifacts/insider-threat/decoded-data.txt', size: '1 KB' }
    ]
  },
  {
    id: 'dfir-disk-memory',
    title: 'Digital Forensics (DFIR) - Disk & Memory Analysis',
    subtitle: 'Autopsy, FTK Imager, Registry & Volatility',
    weekRange: 'Weeks 7-10',
    status: 'Completed',
    icon: '💾',
    description: 'Dove deep into Windows digital forensics. Acquired disk images, analyzed NTFS file systems, parsed Windows registry, and performed volatile memory analysis on suspect workstations.',
    tasks: [
      'Performed forensically sound disk acquisition using FTK Imager (E01 format)',
      'Verified image integrity with MD5/SHA-1 hashing and chain-of-custody documentation',
      'Analyzed NTFS file systems: MFT, Alternate Data Streams (ADS), and MACB timestamps',
      'Used Autopsy to build cases, recover deleted files, and generate forensic reports',
      'Extracted and parsed Windows Security Event Logs with EvtxECmd',
      'Analyzed Prefetch files with PECmd and LNK files with LECmd',
      'Performed memory forensics using Volatility 3 on raw RAM dumps'
    ],
    tools: ['FTK Imager', 'Autopsy', 'Volatility 3', 'Registry Explorer', 'LECmd/PECmd', 'EvtxECmd'],
    findings: [
      'Recovered deleted files from NTFS image including .docx and .xlsx files',
      'Found Alternate Data Stream (ADS) containing malicious JPEG (HARDCORE.jpg)',
      'Identified TrueCrypt service set to Start=System (automatic full-disk encryption)'
    ],
    artifacts: [
      { name: 'Mantooth Case Report (PDF)', path: '/artifacts/dfir-disk-memory/Abdul_Muqeet_Tabraiz_Cyberster_Week_10_Report.pdf', size: '6.1 MB' },
      { name: 'Disk Imaging & MFT Analysis (PDF)', path: '/artifacts/dfir-disk-memory/Abdul_Muqeet_Tabraiz_Cyberster_Week_7_Report.pdf', size: '4.0 MB' },
      { name: 'Registry & Prefetch Analysis (PDF)', path: '/artifacts/dfir-disk-memory/Abdul_Muqeet_Tabraiz_Cyberster_Week_8_Report.pdf', size: '3.5 MB' },
      { name: 'Browser & LNK Forensics (PDF)', path: '/artifacts/dfir-disk-memory/Abdul_Muqeet_Tabraiz_Cyberster_Week_9_Report.pdf', size: '3.8 MB' }
    ]
  },
  {
    id: 'corporate-espionage',
    title: 'Corporate Espionage Investigation (Capstone)',
    subtitle: 'M57.biz Incident: 3-Source Correlation',
    weekRange: 'Weeks 11-12',
    status: 'Completed',
    icon: '🧑‍💻',
    description: 'My Phase Two capstone investigation of a real corporate espionage case. Correlated evidence from disk images, RAM dumps, and USB drives to prove insider threat activity.',
    tasks: [
      'Analyzed PST email archives to uncover Business Email Compromise (BEC) attack',
      'Correlated LNK, Prefetch, and Registry artifacts to prove file access and exfiltration',
      'Identified impersonation attack using display name spoofing with different mailto address',
      'Identified culprit\'s USB device containing stolen patent data',
      'Used Volatility memory analysis to prove user-initiated memory acquisition',
      'Built super-timeline in Autopsy filtering 1M+ events to 8 decisive ones'
    ],
    tools: ['Autopsy', 'Volatility 2/3', 'LECmd/PECmd', 'Registry Explorer', 'Email Parsing', 'USB Forensics', 'Timeline Analysis'],
    findings: [
      'Using super-timeline filtered 1M+ events down to 8 decisive ones proving 4-stage action sequence',
      'Identified two-channel exfiltration: USB drive AND SMB network share (192.168.1.104:139)',
      'Identified underlying mailto address (tuckgorge@gmail.com) different from display (alison@m57.biz)'
    ],
    artifacts: [
      { name: 'BEC Investigation Report (PDF)', path: '/artifacts/corporate-espionage/Abdul_Muqeet_Tabraiz_Cyberster_Week_11_Report.pdf', size: '3.9 MB' },
      { name: 'Super Timeline Filtered (CSV)', path: '/artifacts/corporate-espionage/jean_filtered_timeline_0125_0130.csv', size: '1 KB' },
      { name: 'Master Event Sequence (JSON)', path: '/artifacts/corporate-espionage/master_event_sequence.json', size: '4 KB' }
    ]
  }
];
---

<MainLayout
  title="Security Labs | Abdul Muqeet Tabraiz"
  description="Hands-on cyber security lab environments and tutorials from my Cyberster Blue Team Internship"
>
  <Navbar />

  <main class="pt-24 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Hero Header with Stats -->
      <div class="text-center mb-16">
        <div class="inline-block px-4 py-1 rounded-full bg-cyber-500/10 border border-cyber-500/20 text-cyber-400 text-sm font-mono mb-4">
          🚀 12-Week Blue Team Internship
        </div>
        <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-4">
          Cyberster <span class="text-cyber-400">Internship Labs</span>
        </h1>
        <p class="text-text-secondary text-lg max-w-2xl mx-auto">
          A comprehensive journey through Security Operations Center (SOC) training, digital forensics, and incident response.
        </p>
        
        <!-- Quick Stats -->
        <div class="flex flex-wrap justify-center gap-6 mt-8">
          <div class="flex items-center gap-2 text-text-secondary">
            <span class="text-2xl font-bold text-cyber-400">12</span>
            <span>Weeks</span>
          </div>
          <div class="flex items-center gap-2 text-text-secondary">
            <span class="text-2xl font-bold text-cyber-400">15+</span>
            <span>Tools</span>
          </div>
          <div class="flex items-center gap-2 text-text-secondary">
            <span class="text-2xl font-bold text-cyber-400">5</span>
            <span>Labs</span>
          </div>
          <div class="flex items-center gap-2 text-text-secondary">
            <span class="text-2xl font-bold text-cyber-400">100+</span>
            <span>Alerts Analyzed</span>
          </div>
        </div>
      </div>

      <!-- Labs Grid -->
      <div class="grid md:grid-cols-2 gap-6">
        {labs.map((lab) => (
          <div key={lab.id} class="glass-panel p-6 transition-all duration-300 hover:border-cyber-500/40 hover:shadow-lg hover:shadow-cyber-500/5 flex flex-col h-full relative overflow-hidden">
            
            <!-- Status Badge -->
            <div class="absolute top-4 right-4">
              <span class="px-3 py-1 text-xs font-medium rounded-full bg-green-500/10 text-green-400 border border-green-500/20">
                {lab.status}
              </span>
            </div>

            <!-- Icon & Title -->
            <div class="text-4xl mb-3">{lab.icon}</div>
            <h3 class="text-xl font-semibold text-text-primary mb-1">{lab.title}</h3>
            <p class="text-sm text-cyber-400 font-mono mb-2">{lab.weekRange}</p>
            <p class="text-text-muted text-sm mb-3">{lab.subtitle}</p>
            
            <p class="text-text-secondary text-sm mb-4 flex-grow">{lab.description}</p>
            
            <!-- Expandable Details -->
            <details class="mt-auto">
              <summary class="cursor-pointer text-sm text-cyber-400 hover:text-cyber-300 transition-colors font-medium list-none flex items-center gap-2 py-2">
                <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                Show Details &amp; Artifacts
              </summary>
              
              <div class="mt-4 space-y-4 text-sm border-t border-cyber-500/10 pt-4">
                <!-- Tasks -->
                <div>
                  <h4 class="font-semibold text-text-primary mb-2 flex items-center gap-2">
                    <span class="text-cyber-400">▸</span> Key Tasks
                  </h4>
                  <ul class="list-disc list-inside text-text-secondary space-y-1 ml-2 marker:text-cyber-400">
                    {lab.tasks.map((task) => <li key={task} class="text-sm">{task}</li>)}
                  </ul>
                </div>

                <!-- Tools -->
                <div>
                  <h4 class="font-semibold text-text-primary mb-2 flex items-center gap-2">
                    <span class="text-cyber-400">▸</span> Tools Used
                  </h4>
                  <div class="flex flex-wrap gap-2">
                    {lab.tools.map((tool) => (
                      <span key={tool} class="px-2 py-0.5 text-xs rounded-full bg-cyber-500/10 text-cyber-300 border border-cyber-500/20 font-mono">
                        {tool}
                      </span>
                    ))}
                  </div>
                </div>

                {/* Findings */}
                <div>
                  <h4 class="font-semibold text-text-primary mb-2 flex items-center gap-2">
                    <span class="text-green-400">✓</span> Key Findings
                  </h4>
                  <ul class="list-disc list-inside text-text-secondary space-y-1 ml-2 marker:text-green-400">
                    {lab.findings.map((finding) => <li key={finding} class="text-sm">{finding}</li>)}
                  </ul>
                </div>

                {/* Artifacts - Download Section */}
                {lab.artifacts && lab.artifacts.length > 0 && (
                  <div class="mt-4 pt-4 border-t border-cyber-500/20">
                    <h4 class="font-semibold text-text-primary mb-3 flex items-center gap-2">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                      📁 Download Artifacts
                    </h4>
                    <div class="space-y-2">
                      {lab.artifacts.map((file) => (
                        <div key={file.path} class="flex items-center justify-between p-2 rounded-lg bg-cyber-900/30 hover:bg-cyber-900/50 transition-colors">
                          <div class="flex items-center gap-2 truncate flex-1">
                            <span class="text-xs text-cyber-400">📄</span>
                            <span class="text-text-secondary text-xs truncate">{file.name}</span>
                          </div>
                          <div class="flex items-center gap-3 flex-shrink-0 ml-2">
                            <span class="text-xs text-text-muted">{file.size}</span>
                            {file.path.startsWith('http') ? (
                              <a 
                                href={file.path} 
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-1 px-3 py-1 text-xs font-medium text-text-primary bg-cyber-500/20 hover:bg-cyber-500/30 rounded-lg transition-all border border-cyber-500/30 hover:border-cyber-400/50"
                              >
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                                View
                              </a>
                            ) : (
                              <a 
                                href={file.path} 
                                download
                                class="inline-flex items-center gap-1 px-3 py-1 text-xs font-medium text-text-primary bg-cyber-500/20 hover:bg-cyber-500/30 rounded-lg transition-all border border-cyber-500/30 hover:border-cyber-400/50"
                              >
                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
                                Download
                              </a>
                            )}
                          </div>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            </details>
          </div>
        ))}
      </div>

      <!-- Bottom Call-to-Action -->
      <div class="glass-panel p-8 mt-16 text-center border border-cyber-500/10">
        <h2 class="text-2xl font-bold text-text-primary mb-4">Ready to See More?</h2>
        <p class="text-text-secondary mb-6">
          Download the artifacts above to see the full reports, rules, and analysis from my internship.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/projects" class="px-6 py-2 rounded-lg bg-cyber-500 text-white font-medium hover:bg-cyber-600 transition-colors">
            View All Projects →
          </a>
          <a href="/contact" class="px-6 py-2 rounded-lg border border-cyber-500/30 text-text-primary hover:bg-cyber-500/10 transition-colors">
            Contact Me
          </a>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</MainLayout>