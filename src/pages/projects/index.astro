---
import MainLayout from '../../layouts/MainLayout.astro';
import Navbar from '../../components/layout/Navbar.astro';
import Footer from '../../components/layout/Footer.astro';
import { getAllRepositories } from '../../lib/github';

const repos = await getAllRepositories();
---

<MainLayout
  title="Projects | Abdul Muqeet Tabraiz"
  description="Open source projects by Abdul Muqeet Tabraiz"
>
  <Navbar />

  <main class="pt-24 pb-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Header -->
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-4">
          Projects
        </h1>

        <p class="text-text-secondary text-lg">
          Open source projects and applications
        </p>
      </div>

      <!-- Repository count -->
      <div class="glass-panel p-6 mb-8 text-center">
        <p class="text-text-primary text-lg">
          Showing
          <span class="gradient-text font-bold">
            {repos.length}
          </span>
          repositories
        </p>
      </div>

      <!-- Projects Grid -->
      {repos.length > 0 ? (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">

          {repos.map((repo: any) => (
            <a
              href={`/projects/${repo.name}`}
              class="glass-panel p-6 transition-all duration-300 block hover:border-cyber-500/30"
            >

              <!-- Repository name + stars -->
              <div class="flex items-start justify-between mb-3">

                <h3 class="font-semibold text-text-primary text-lg break-words">
                  {repo.name}
                </h3>

                {repo.stargazers_count > 0 && (
                  <span class="flex items-center gap-1 text-text-muted text-sm flex-shrink-0 ml-3">
                    <svg
                      class="w-4 h-4"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>

                    {repo.stargazers_count}
                  </span>
                )}

              </div>

              <!-- Description -->
              <p class="text-text-muted text-sm mb-4 line-clamp-3">
                {repo.description || 'No description provided'}
              </p>

              <!-- Language + topics -->
              <div class="flex items-center gap-2 flex-wrap">

                {repo.language && (
                  <span class="px-2 py-0.5 text-xs rounded-full bg-cyber-500/10 text-cyber-400">
                    {repo.language}
                  </span>
                )}

                {repo.topics &&
                  repo.topics.slice(0, 3).map((topic: string) => (
                    <span
                      class="px-2 py-0.5 text-xs rounded-full bg-surface text-text-muted border border-surface-border"
                    >
                      {topic}
                    </span>
                  ))
                }

              </div>

              <!-- Updated date -->
              <p class="text-text-muted text-xs mt-3">
                Updated
                {new Date(repo.updated_at).toLocaleDateString(
                  'en-US',
                  {
                    month: 'short',
                    day: 'numeric',
                    year: 'numeric',
                  }
                )}
              </p>

            </a>
          ))}

        </div>
      ) : (
        <div class="text-center">
          <div class="glass-panel p-12 max-w-lg mx-auto">

            <div class="text-5xl mb-4">
              📂
            </div>

            <h2 class="text-xl font-semibold text-text-primary mb-4">
              No public projects found
            </h2>

            <p class="text-text-muted mb-6">
              No eligible public repositories were found for this GitHub account.
            </p>

            <a
              href="https://github.com/JuttSahib1999?tab=repositories"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-6 py-3 bg-cyber-500 text-white rounded-lg font-medium hover:bg-cyber-600 transition-colors"
            >
              <svg
                class="w-5 h-5"
                fill="currentColor"
                viewBox="0 0 24 24"
              >
                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688.103-.253.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
              </svg>

              View All Repositories on GitHub
            </a>

          </div>
        </div>
      )}

    </div>
  </main>

  <Footer />
</MainLayout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
