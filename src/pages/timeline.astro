---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
---

<MainLayout
  title="Timeline | Abdul Muqeet Tabraiz"
  description="Career journey and experience timeline of Abdul Muqeet Tabraiz"
>
  <Navbar />
  
  <main class="pt-24 pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Header -->
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-4">
          Career Timeline
        </h1>
        <p class="text-text-secondary text-lg">
          My journey in Cyber Security
        </p>
      </div>
      
      <!-- Timeline -->
      <div class="relative">
        <!-- Vertical Line -->
        <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-surface-border transform md:-translate-x-px"></div>
        
        <div class="space-y-12">
          
          <!-- Timeline Item 1: Cyberster -->
          <div class="relative flex items-start">
            <div class="absolute left-4 md:left-1/2 w-8 h-8 rounded-full bg-cyber-500 border-4 border-background transform -translate-x-1/2 flex items-center justify-center z-10">
              <span class="text-white text-xs">★</span>
            </div>
            <div class="ml-16 md:ml-0 md:w-1/2 md:pr-12 md:text-right">
              <div class="glass-panel p-6">
                <span class="text-cyber-400 text-sm font-mono">March 2026 - May 2026</span>
                <h3 class="text-lg font-semibold text-text-primary mt-1">Blue Team Intern • Cyberster</h3>
                <p class="text-text-muted text-sm mt-2">Islāmābād, Pakistan — Focused on blue team operations, defense strategies, and security monitoring tasks.</p>
              </div>
            </div>
          </div>
          
          <!-- Timeline Item 2: DevelopersHub Corporation -->
          <div class="relative flex items-start">
            <div class="absolute left-4 md:left-1/2 w-8 h-8 rounded-full bg-soc-500 border-4 border-background transform -translate-x-1/2 flex items-center justify-center z-10">
              <span class="text-white text-xs">◆</span>
            </div>
            <div class="ml-16 md:ml-auto md:w-1/2 md:pl-12">
              <div class="glass-panel p-6">
                <span class="text-soc-400 text-sm font-mono">February 2026 - March 2026</span>
                <h3 class="text-lg font-semibold text-text-primary mt-1">Cyber Security Intern • DevelopersHub Corporation</h3>
                <p class="text-text-muted text-sm mt-2">Pakistan — Engaged in practical cybersecurity workflows and technical task execution.</p>
              </div>
            </div>
          </div>
          
          <!-- Timeline Item 3: Syntecxhub -->
          <div class="relative flex items-start">
            <div class="absolute left-4 md:left-1/2 w-8 h-8 rounded-full bg-purple-400 border-4 border-background transform -translate-x-1/2 flex items-center justify-center z-10">
              <span class="text-white text-xs">⬡</span>
            </div>
            <div class="ml-16 md:ml-0 md:w-1/2 md:pr-12 md:text-right">
              <div class="glass-panel p-6">
                <span class="text-purple-400 text-sm font-mono">January 2026 - February 2026</span>
                <h3 class="text-lg font-semibold text-text-primary mt-1">Cyber Security Intern • Syntecxhub</h3>
                <p class="text-text-muted text-sm mt-2">Remote — Gained hands-on remote experience in cybersecurity principles and analysis.</p>
              </div>
            </div>
          </div>
          
          <!-- Timeline Item 4: The Red Users -->
          <div class="relative flex items-start">
            <div class="absolute left-4 md:left-1/2 w-8 h-8 rounded-full bg-success border-4 border-background transform -translate-x-1/2 flex items-center justify-center z-10">
              <span class="text-white text-xs">●</span>
            </div>
            <div class="ml-16 md:ml-auto md:w-1/2 md:pl-12">
              <div class="glass-panel p-6">
                <span class="text-success text-sm font-mono">December 2024 - January 2025</span>
                <h3 class="text-lg font-semibold text-text-primary mt-1">Cyber Security Intern • The Red Users</h3>
                <p class="text-text-muted text-sm mt-2">India — Analyzed network traffic, examined web application vulnerabilities, and worked with firewall configurations.</p>
              </div>
            </div>
          </div>

          <!-- Timeline Item 5: Vista Impex Intl -->
          <div class="relative flex items-start">
            <div class="absolute left-4 md:left-1/2 w-8 h-8 rounded-full bg-cyber-500 border-4 border-background transform -translate-x-1/2 flex items-center justify-center z-10">
              <span class="text-white text-xs">★</span>
            </div>
            <div class="ml-16 md:ml-0 md:w-1/2 md:pr-12 md:text-right">
              <div class="glass-panel p-6">
                <span class="text-cyber-400 text-sm font-mono">June 2024 - June 2025</span>
                <h3 class="text-lg font-semibold text-text-primary mt-1">Cyber Security Specialist • Vista Impex Intl</h3>
                <p class="text-text-muted text-sm mt-2">Sialkot, Punjab, Pakistan — Safeguarded sensitive company and client data, implemented security protocols and firewalls, provided network infrastructure support, and monitored network traffic using Wireshark.</p>
              </div>
            </div>
          </div>

          <!-- Timeline Item 6: University Education & Certifications -->
          <div class="relative flex items-start">
            <div class="absolute left-4 md:left-1/2 w-8 h-8 rounded-full bg-soc-500 border-4 border-background transform -translate-x-1/2 flex items-center justify-center z-10">
              <span class="text-white text-xs">◆</span>
            </div>
            <div class="ml-16 md:ml-auto md:w-1/2 md:pl-12">
              <div class="glass-panel p-6">
                <span class="text-soc-400 text-sm font-mono">2019 - 2024</span>
                <h3 class="text-lg font-semibold text-text-primary mt-1">Information Technology & Security Education</h3>
                <p class="text-text-muted text-sm mt-2">University of Sialkot — Completed Associate's and Bachelor's degrees in IT, followed by specialized CEH/CHFI training in cyber forensics and counterterrorism.</p>
              </div>
            </div>
          </div>
          
        </div>
      </div>
      
    </div>
  </main>
  
  <Footer />
</MainLayout>
