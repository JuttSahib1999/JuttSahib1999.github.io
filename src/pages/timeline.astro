
---
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';
---

<MainLayout
  title="Career Timeline | Abdul Muqeet Tabraiz"
  description="Professional career journey of Abdul Muqeet Tabraiz, covering IT Support, Cyber Security Instruction, SOC Operations, Blue Team, and Cybersecurity."
>
  <Navbar />

  <main class="pt-24 pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Header -->
      <div class="text-center mb-16">
        <h1 class="text-4xl md:text-5xl font-bold text-text-primary mb-4">
          Career Timeline
        </h1>

        <p class="text-text-secondary text-lg">
          My professional journey in Information Technology and Cyber Security
        </p>

        <a
          href="https://www.linkedin.com/in/abdul-muqeet-tabraiz/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 mt-6 text-cyber-400 hover:text-cyber-300 transition-colors text-sm font-medium"
        >
          View LinkedIn Profile →
        </a>
      </div>

      <!-- Timeline -->
      <div class="relative">

        <!-- Vertical Line -->
        <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-surface-border transform md:-translate-x-px"></div>

        <div class="space-y-12">

          <!-- Timeline Item 1: 360 Technologies -->
          <div class="relative flex items-start">
            <div class="absolute left-4 md:left-1/2 w-8 h-8 rounded-full bg-cyber-500 border-4 border-background transform -translate-x-1/2 flex items-center justify-center z-10">
              <span class="text-white text-xs">★</span>
            </div>

            <div class="ml-16 md:ml-0 md:w-1/2 md:pr-12 md:text-right">
              <div class="glass-panel p-6">
                <span class="text-cyber-400 text-sm font-mono">
                  September 2026 - Present
                </span>

                <h3 class="text-lg font-semibold text-text-primary mt-1">
                  Support Engineer • 360 TECHNOLOGIES
                </h3>

                <p class="text-text-muted text-sm mt-2">
                  Sialkot, Punjab, Pakistan — Working in IT support, technical troubleshooting, and infrastructure support.
                </p>

                <span class="inline-block mt-3 text-xs text-cyber-400 border border-cyber-500/30 rounded-full px-3 py-1">
                  Full-Time
                </span>
              </div>
            </div>
          </div>

          <!-- Timeline Item 2: Web Excels -->
          <div class="relative flex items-start">
            <div class="absolute left-4 md:left-1/2 w-8 h-8 rounded-full bg-purple-500 border-4 border-background transform -translate-x-1/2 flex items-center justify-center z-10">
              <span class="text-white text-xs">◆</span>
            </div>

            <div class="ml-16 md:ml-auto md:w-1/2 md:pl-12">
              <div class="glass-panel p-6">
                <span class="text-purple-400 text-sm font-mono">
                  June 2026 - Present
                </span>

                <h3 class="text-lg font-semibold text-text-primary mt-1">
                  Cyber Security Instructor • Web Excels
                </h3>

                <p class="text-text-muted text-sm mt-2">
                  Pakistan — Teaching cybersecurity fundamentals, networking, ethical hacking, defensive security, SOC operations, and practical security concepts through structured lessons and hands-on demonstrations.
                </p>

                <span class="inline-block mt-3 text-xs text-purple-400 border border-purple-500/30 rounded-full px-3 py-1">
                  Teaching & Training
                </span>
              </div>
            </div>
          </div>

          <!-- Timeline Item 3: Cyberster Intern & Volunteer -->
          <div class="relative flex items-start">
            <div class="absolute left-4 md:left-1/2 w-8 h-8 rounded-full bg-success border-4 border-background transform -translate-x-1/2 flex items-center justify-center z-10">
              <span class="text-white text-xs">●</span>
            </div>

            <div class="ml-16 md:ml-0 md:w-1/2 md:pr-12 md:text-right">
              <div class="glass-panel p-6">
                <span class="text-success text-sm font-mono">
                  May 2026 - October 2026
                </span>

                <h3 class="text-lg font-semibold text-text-primary mt-1">
                  Intern & Volunteer • Cyberster
                </h3>

                <p class="text-text-muted text-sm mt-2">
                  Pakistan — Continued involvement with Cyberster following the Blue Team internship, contributing to cybersecurity learning, practical activities, and professional development.
                </p>

                <span class="inline-block mt-3 text-xs text-success border border-success/30 rounded-full px-3 py-1">
                  Internship & Volunteer
                </span>
              </div>
            </div>
          </div>

          <!-- Timeline Item 4: Cyberster Blue Team -->
          <div class="relative flex items-start">
            <div class="absolute left-4 md:left-1/2 w-8 h-8 rounded-full bg-cyber-500 border-4 border-background transform -translate-x-1/2 flex items-center justify-center z-10">
              <span class="text-white text-xs">★</span>
            </div>

            <div class="ml-16 md:ml-auto md:w-1/2 md:pl-12">
              <div class="glass-panel p-6">
                <span class="text-cyber-400 text-sm font-mono">
                  March 2026 - May 2026
                </span>

                <h3 class="text-lg font-semibold text-text-primary mt-1">
                  Blue Team Intern • Cyberster
                </h3>

                <p class="text-text-muted text-sm mt-2">
                  Islamabad, Pakistan — Developed practical defensive security experience through SIEM monitoring, Wazuh configuration, file integrity monitoring, security event analysis, Suricata IDS, threat detection, and incident investigation.
                </p>

                <span class="inline-block mt-3 text-xs text-cyber-400 border border-cyber-500/30 rounded-full px-3 py-1">
                  Blue Team Operations
                </span>
              </div>
            </div>
          </div>

          <!-- Timeline Item 5: DevelopersHub -->
          <div class="relative flex items-start">
            <div class="absolute left-4 md:left-1/2 w-8 h-8 rounded-full bg-soc-500 border-4 border-background transform -translate-x-1/2 flex items-center justify-center z-10">
              <span class="text-white text-xs">◆</span>
            </div>

            <div class="ml-16 md:ml-0 md:w-1/2 md:pr-12 md:text-right">
              <div class="glass-panel p-6">
                <span class="text-soc-400 text-sm font-mono">
                  February 2026 - March 2026
                </span>

                <h3 class="text-lg font-semibold text-text-primary mt-1">
                  Cyber Security Intern • DevelopersHub Corporation
                </h3>

                <p class="text-text-muted text-sm mt-2">
                  Pakistan — Worked on practical cybersecurity assignments, security testing, vulnerability assessment, and hands-on technical projects.
                </p>

                <span class="inline-block mt-3 text-xs text-soc-400 border border-soc-500/30 rounded-full px-3 py-1">
                  Cybersecurity Internship
                </span>
              </div>
            </div>
          </div>

          <!-- Timeline Item 6: Syntecxhub -->
          <div class="relative flex items-start">
            <div class="absolute left-4 md:left-1/2 w-8 h-8 rounded-full bg-purple-400 border-4 border-background transform -translate-x-1/2 flex items-center justify-center z-10">
              <span class="text-white text-xs">⬡</span>
            </div>

            <div class="ml-16 md:ml-auto md:w-1/2 md:pl-12">
              <div class="glass-panel p-6">
                <span class="text-purple-400 text-sm font-mono">
                  January 2026 - February 2026
                </span>

                <h3 class="text-lg font-semibold text-text-primary mt-1">
                  Cyber Security Intern • Syntecxhub
                </h3>

                <p class="text-text-muted text-sm mt-2">
                  Remote — Gained practical exposure to cybersecurity concepts, technical assignments, security analysis, and hands-on project development.
                </p>

                <span class="inline-block mt-3 text-xs text-purple-400 border border-purple-500/30 rounded-full px-3 py-1">
                  Remote Internship
                </span>
              </div>
            </div>
          </div>

          <!-- Timeline Item 7: The Red Users -->
          <div class="relative flex items-start">
            <div class="absolute left-4 md:left-1/2 w-8 h-8 rounded-full bg-success border-4 border-background transform -translate-x-1/2 flex items-center justify-center z-10">
              <span class="text-white text-xs">●</span>
            </div>

            <div class="ml-16 md:ml-0 md:w-1/2 md:pr-12 md:text-right">
              <div class="glass-panel p-6">
                <span class="text-success text-sm font-mono">
                  December 2024 - January 2025
                </span>

                <h3 class="text-lg font-semibold text-text-primary mt-1">
                  Cyber Security Intern • The Red Users
                </h3>

                <p class="text-text-muted text-sm mt-2">
                  India — Gained introductory practical exposure to cybersecurity, network security, vulnerability assessment, and security testing.
                </p>

                <span class="inline-block mt-3 text-xs text-success border border-success/30 rounded-full px-3 py-1">
                  Cybersecurity Internship
                </span>
              </div>
            </div>
          </div>

          <!-- Timeline Item 8: Vista Impex -->
          <div class="relative flex items-start">
            <div class="absolute left-4 md:left-1/2 w-8 h-8 rounded-full bg-cyber-500 border-4 border-background transform -translate-x-1/2 flex items-center justify-center z-10">
              <span class="text-white text-xs">★</span>
            </div>

            <div class="ml-16 md:ml-auto md:w-1/2 md:pl-12">
              <div class="glass-panel p-6">
                <span class="text-cyber-400 text-sm font-mono">
                  June 2024 - June 2025
                </span>

                <h3 class="text-lg font-semibold text-text-primary mt-1">
                  IT & Network Support • Vista Impex Intl
                </h3>

                <p class="text-text-muted text-sm mt-2">
                  Sialkot, Punjab, Pakistan — Gained practical workplace exposure to basic IT operations, network management, and technical support activities.
                </p>

                <span class="inline-block mt-3 text-xs text-cyber-400 border border-cyber-500/30 rounded-full px-3 py-1">
                  IT & Network Support
                </span>
              </div>
            </div>
          </div>

          <!-- Timeline Item 9: Education -->
          <div class="relative flex items-start">
            <div class="absolute left-4 md:left-1/2 w-8 h-8 rounded-full bg-soc-500 border-4 border-background transform -translate-x-1/2 flex items-center justify-center z-10">
              <span class="text-white text-xs">◆</span>
            </div>

            <div class="ml-16 md:ml-0 md:w-1/2 md:pr-12 md:text-right">
              <div class="glass-panel p-6">
                <span class="text-soc-400 text-sm font-mono">
                  2019 - 2024
                </span>

                <h3 class="text-lg font-semibold text-text-primary mt-1">
                  Information Technology Education
                </h3>

                <p class="text-text-muted text-sm mt-2">
                  University of Sialkot — Associate Degree in Information Technology (AD-IT), 2019 - 2021, followed by Bachelor's Degree in Information Technology (BS-IT), 2022 - 2024.
                </p>

                <span class="inline-block mt-3 text-xs text-soc-400 border border-soc-500/30 rounded-full px-3 py-1">
                  Academic Education
                </span>
              </div>
            </div>
          </div>

          <!-- Timeline Item 10: Cybersecurity Training -->
          <div class="relative flex items-start">
            <div class="absolute left-4 md:left-1/2 w-8 h-8 rounded-full bg-purple-500 border-4 border-background transform -translate-x-1/2 flex items-center justify-center z-10">
              <span class="text-white text-xs">⬡</span>
            </div>

            <div class="ml-16 md:ml-auto md:w-1/2 md:pl-12">
              <div class="glass-panel p-6">
                <span class="text-purple-400 text-sm font-mono">
                  2024 - 2026
                </span>

                <h3 class="text-lg font-semibold text-text-primary mt-1">
                  Cybersecurity Certifications & Professional Training
                </h3>

                <p class="text-text-muted text-sm mt-2">
                  Continued professional development through cybersecurity training, ethical hacking, digital forensics, networking, SOC operations, and defensive security.
                </p>

                <ul class="text-text-muted text-sm mt-3 space-y-2">
                  <li>• Certified Ethical Hacker (CEH) – EC-Council</li>
                  <li>• Introduction to Digital Forensics – Cyber5W</li>
                  <li>• Phishing Expert – LetsDefend</li>
                  <li>• SOC Member – LetsDefend</li>
                  <li>• Networking Basics – Cisco</li>
                  <li>• ISC2 Candidate – ISC2 (October 2025)</li>
                  <li>• Cybersecurity Internship – Syntecxhub</li>
                </ul>

                <span class="inline-block mt-3 text-xs text-purple-400 border border-purple-500/30 rounded-full px-3 py-1">
                  Continuous Learning
                </span>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </main>

  <Footer />
</MainLayout>
